NODE_ENV=development
PORT=4000
# Required in production: a long random string (openssl rand -base64 48)
JWT_SECRET=
DB_PATH=./data/printpro.db
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# First-run admin account (created only if no admin exists). Quote values that contain #
SEED_ADMIN_EMAIL=amr@example.com
SEED_ADMIN_PASSWORD="Studio#2026Pass"
